# ============================
# Backend (Python / Flask)
# ============================

# Python cache & compiled files
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
venv/
.venv/

# Local configuration & environment files
.env
*.env

# SQLite database files
*.db
*.sqlite3

# Logs & runtime data
backend/logs/
*.log

# Coverage / testing
.coverage
htmlcov/
pytest_cache/

# ============================
# Frontend (Node / Vite / React)
# ============================

# Dependency directories
frontend/node_modules/
node_modules/

# Build and cache artifacts
frontend/dist/
frontend/build/
frontend/.vite/
frontend/.cache/
dist/
build/
.vite/

# Editor / system files
.DS_Store
Thumbs.db
.vscode/
.idea/

# ============================
# Misc
# ============================

# OS / temporary files
*.bak
*.swp
*.tmp
*.lock

# Dev scratch artifacts (screenshots & ad-hoc inspection scripts)
select_screen_preview.png

# Ad-hoc Puppeteer viewport sandbox. Local scratch only: it is not wired into any
# test, script, or runbook, and its scenario ids no longer match
# frontend/src/kiosk/dev/kioskPreviewScenarios.js.
test-sandbox/

# ============================
# Runtime database artifacts
# ============================
# `*.db` only matches names ENDING in .db, and `*.bak` only names ending in .bak,
# so a dated backup such as codes.db.bak.<timestamp> slipped past both and was
# committed with real credentials inside it. Match the whole family instead.
*.db.*
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3-*
*.dump
*.sql.gz

# Dev/admin config exports: no raw secrets, but device IPs and machine/relay
# mappings. Narrow patterns so real fixtures (package.json, docs/**/*.json) stay.
config-export*.json
dev-admin-export*.json
*-config-export.json
